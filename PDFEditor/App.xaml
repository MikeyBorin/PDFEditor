<Application x:Class="PDFEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PDFEditor"
             xmlns:ctrl="clr-namespace:PDFEditor.Controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <ctrl:InsetConverter x:Key="InsetConverter" Inset="60" />
            <ctrl:ZoomWidthConverter x:Key="ZoomWidth" />
            <ctrl:ContrastBorderConverter x:Key="ContrastBorder" />
            <ctrl:ColorToBrushConverter x:Key="ColorToBrush" />
            <ctrl:OneBasedIndexConverter x:Key="OneBasedIndex" />
            <ctrl:EqualityToBrushConverter x:Key="ActiveToolBg" />
            <ctrl:SigPathConverter x:Key="SigPathConverter" />

            <!-- Theme brushes: ThemeService swaps these resource entries at runtime.
                 All consumers use DynamicResource so the swap propagates. -->
            <SolidColorBrush x:Key="Bg" Color="#1E1F22" />
            <SolidColorBrush x:Key="Panel" Color="#2B2D31" />
            <SolidColorBrush x:Key="PanelAlt" Color="#232428" />
            <SolidColorBrush x:Key="Border" Color="#3B3D42" />
            <SolidColorBrush x:Key="Text" Color="#E6E6E6" />
            <SolidColorBrush x:Key="TextMuted" Color="#9AA0A6" />
            <SolidColorBrush x:Key="Accent" Color="#4C8BF5" />
            <SolidColorBrush x:Key="AccentHover" Color="#6BA0FF" />
            <SolidColorBrush x:Key="InputBg" Color="#1A1B1E" />
            <SolidColorBrush x:Key="InputFg" Color="#E6E6E6" />
            <SolidColorBrush x:Key="Hover" Color="#3A3C42" />
            <SolidColorBrush x:Key="Pressed" Color="#4A4C52" />
            <SolidColorBrush x:Key="Selection" Color="#4C8BF5" />
            <SolidColorBrush x:Key="SelectionText" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuPopupBg" Color="#24262A" />
            <SolidColorBrush x:Key="MenuPopupFg" Color="#E6E6E6" />

            <Style TargetType="{x:Type Button}" x:Key="ToolButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type TextBlock}" x:Key="ToolGlyph">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
            </Style>
            <Style TargetType="{x:Type TextBlock}" x:Key="ToolLabel">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
            </Style>

            <Style TargetType="{x:Type Button}" x:Key="ToolToggleButton" BasedOn="{StaticResource ToolButton}">
                <Setter Property="Background">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource ActiveToolBg}">
                            <Binding Path="CurrentTool" />
                            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Button}" x:Key="RailButton" BasedOn="{StaticResource ToolButton}">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource ActiveToolBg}">
                            <Binding Path="CurrentTool" />
                            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Menu}">
                <Setter Property="Background" Value="{DynamicResource Panel}" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
            </Style>

            <!-- Fully theme-managed MenuItem with distinct templates per role. -->
            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <!-- Top-level header: "File", "Edit"... on the menu bar -->
                    <Trigger Property="Role" Value="TopLevelHeader">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type MenuItem}">
                                    <Grid>
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="10,4">
                                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextBlock.Foreground="{DynamicResource Text}"/>
                                        </Border>
                                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False" PopupAnimation="Fade">
                                            <Border Background="{DynamicResource MenuPopupBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="2">
                                                <ScrollViewer CanContentScroll="True" Style="{x:Null}">
                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSubmenuOpen" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <!-- Submenu popup contains items with these roles -->
                    <Trigger Property="Role" Value="SubmenuHeader">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type MenuItem}">
                                    <Grid>
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="20,4,20,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="16"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True" TextBlock.Foreground="{DynamicResource MenuPopupFg}"/>
                                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource TextMuted}" Margin="16,0,0,0"/>
                                                <Path Grid.Column="2" Data="M0,0 L4,4 L0,8 Z" Fill="{DynamicResource MenuPopupFg}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True" IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False" PopupAnimation="Fade">
                                            <Border Background="{DynamicResource MenuPopupBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="2">
                                                <ScrollViewer CanContentScroll="True" Style="{x:Null}">
                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selection}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="Role" Value="SubmenuItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type MenuItem}">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="20,4,20,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter x:Name="HeaderPresenter" Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True" TextBlock.Foreground="{DynamicResource MenuPopupFg}"/>
                                            <TextBlock x:Name="GestureText" Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource TextMuted}" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selection}"/>
                                            <Setter TargetName="HeaderPresenter" Property="TextBlock.Foreground" Value="{DynamicResource SelectionText}"/>
                                            <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource SelectionText}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="Background" Value="{DynamicResource MenuPopupBg}" />
                <Setter Property="Foreground" Value="{DynamicResource MenuPopupFg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource InputBg}" />
                <Setter Property="Foreground" Value="{DynamicResource InputFg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="CaretBrush" Value="{DynamicResource InputFg}" />
            </Style>
            <Style TargetType="{x:Type ScrollViewer}">
                <Setter Property="Background" Value="{DynamicResource Bg}" />
            </Style>
            <Style TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style TargetType="{x:Type Separator}">
                <Setter Property="Margin" Value="6,4" />
                <Setter Property="Background" Value="{DynamicResource Border}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
