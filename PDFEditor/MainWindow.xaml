<Window x:Class="PDFEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PDFEditor.ViewModels"
        xmlns:ctrl="clr-namespace:PDFEditor.Controls"
        Title="{Binding Title}"
        Height="820" Width="1300"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="Window_Drop"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        WindowState="Maximized"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- menu -->
            <RowDefinition Height="Auto"/> <!-- toolbar -->
            <RowDefinition Height="*"/>    <!-- content -->
            <RowDefinition Height="Auto"/> <!-- status -->
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" Padding="4">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}" DataContext="{Binding}">
                    <MenuItem.ItemContainerStyle>
                        <!-- Inherit the theme-aware MenuItem style (which has SubmenuItem template + hover triggers)
                             and only override the per-item bindings. -->
                        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="Clear Recent" Command="{Binding ClearRecentCommand}"/>
                <Separator/>
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="_Export">
                    <MenuItem Header="As _Word (.docx)..." Command="{Binding ExportAsWordCommand}"/>
                    <MenuItem Header="As _Excel (.xlsx)..." Command="{Binding ExportAsExcelCommand}"/>
                    <MenuItem Header="As _HTML..." Command="{Binding ExportAsHtmlCommand}"/>
                    <MenuItem Header="As _PNG images..." Command="{Binding ExportAsImagesCommand}" CommandParameter="png"/>
                    <MenuItem Header="As _JPEG images..." Command="{Binding ExportAsImagesCommand}" CommandParameter="jpg"/>
                </MenuItem>
                <MenuItem Header="Edit in Word (_round-trip)..." Command="{Binding EditInWordCommand}"/>
                <Separator/>
                <MenuItem Header="Convert _to PDF..." Command="{Binding ConvertToPdfCommand}"/>
                <MenuItem Header="Convert _Multiple to PDF..." Command="{Binding ConvertMultipleToPdfCommand}"/>
                <Separator/>
                <MenuItem Header="_Combine PDFs..." Command="{Binding MergeFilesCommand}"/>
                <MenuItem Header="Split (each page)..." Command="{Binding SplitEachPageCommand}"/>
                <MenuItem Header="Extract Pages..." Command="{Binding ExtractRangeCommand}"/>
                <MenuItem Header="Insert PDF..." Command="{Binding InsertPagesFromFileCommand}"/>
                <Separator/>
                <MenuItem Header="_Print" Command="{Binding PrintCommand}" InputGestureText="Ctrl+P"/>
                <Separator/>
                <MenuItem Header="Register as PDF _Handler..." Command="{Binding RegisterFileAssociationCommand}" ToolTip="Add PDF Editor to Windows &quot;Open with&quot; and Default apps."/>
                <MenuItem Header="_Unregister as PDF Handler" Command="{Binding UnregisterFileAssociationCommand}" ToolTip="Remove PDF Editor's file-association entries."/>
                <Separator/>
                <MenuItem Header="_Close" Command="{Binding CloseCommand}"/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="Edit _History..." Command="{Binding ShowHistoryCommand}" ToolTip="View or roll back the session's edit history"/>
                <MenuItem Header="_Edit Selected Annotation..." Command="{Binding EditSelectedAnnotationCommand}" InputGestureText="F2 / Enter"/>
                <MenuItem Header="_Delete Selected Annotation" Command="{Binding DeleteSelectedAnnotationCommand}" InputGestureText="Delete"/>
            </MenuItem>
            <MenuItem Header="_Page">
                <MenuItem Header="Rotate _Left" Command="{Binding RotateLeftCommand}"/>
                <MenuItem Header="Rotate _Right" Command="{Binding RotateRightCommand}"/>
                <MenuItem Header="_Delete Current" Command="{Binding DeleteCurrentPageCommand}"/>
                <Separator/>
                <MenuItem Header="_Crop All Pages..." Command="{Binding CropAllPagesCommand}"/>
                <Separator/>
                <MenuItem Header="_Organise Pages..." Command="{Binding OrganizePagesCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Extract Text" Command="{Binding ExtractTextCommand}"/>
                <MenuItem Header="OCR Current Page" Command="{Binding RunOcrOnCurrentCommand}"/>
                <MenuItem Header="OCR All Pages → text file..." Command="{Binding OcrAllPagesCommand}"/>
                <MenuItem Header="Make Searchable PDF (OCR)..." Command="{Binding MakeSearchablePdfCommand}"/>
                <MenuItem Header="_Download OCR Training Data (English)..." Command="{Binding DownloadOcrDataDefaultCommand}" ToolTip="Downloads eng.traineddata (~22 MB) from GitHub and installs it into the app's tessdata folder."/>
                <Separator/>
                <MenuItem Header="_Translate..." Command="{Binding TranslateCommand}" ToolTip="Translate extracted text via MyMemory (free public API, no signup)"/>
                <Separator/>
                <MenuItem Header="_Watermark..." Command="{Binding WatermarkCommand}" ToolTip="Add a new watermark, or list/remove ones previously added by this app"/>
                <MenuItem Header="Add _Headers &amp; Footers..." Command="{Binding AddHeadersFootersCommand}"/>
                <MenuItem Header="Add _Bates Numbering..." Command="{Binding AddBatesCommand}"/>
                <MenuItem Header="Insert Image on Current Page..." Command="{Binding InsertImageOnCurrentCommand}"/>
                <MenuItem Header="_Fill Form..." Command="{Binding FillFormCommand}"/>
                <MenuItem Header="_Signatures..." Command="{Binding OpenSignatureLibraryCommand}"/>
                <MenuItem Header="_Compare with another PDF..." Command="{Binding CompareWithFileCommand}"/>
                <MenuItem Header="_Redact Search Results" Command="{Binding RedactSearchResultsCommand}"/>
                <Separator/>
                <MenuItem Header="_Security">
                    <MenuItem Header="Password Protect..." Command="{Binding ProtectWithPasswordCommand}"/>
                    <MenuItem Header="Remove Protection" Command="{Binding RemoveProtectionCommand}"/>
                    <MenuItem Header="Sanitize Metadata" Command="{Binding SanitizeMetadataCommand}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Clear _Annotations..." Command="{Binding ClearAnnotationsCommand}" ToolTip="Remove unsaved overlay annotations on the current page or all pages; Ctrl+Z restores"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom In" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++"/>
                <MenuItem Header="Zoom Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-"/>
                <MenuItem Header="Reset Zoom" Command="{Binding ZoomResetCommand}" InputGestureText="Ctrl+0"/>
                <Separator/>
                <MenuItem Header="Fit _Width"
                          IsCheckable="True"
                          IsChecked="{Binding ZoomMode, Converter={StaticResource EnumEquals}, ConverterParameter=FitWidth, Mode=OneWay}"
                          Command="{Binding SetZoomModeCommand}" CommandParameter="{x:Static vm:ZoomMode.FitWidth}"/>
                <MenuItem Header="Fit _Page"
                          IsCheckable="True"
                          IsChecked="{Binding ZoomMode, Converter={StaticResource EnumEquals}, ConverterParameter=FitPage, Mode=OneWay}"
                          Command="{Binding SetZoomModeCommand}" CommandParameter="{x:Static vm:ZoomMode.FitPage}"/>
                <MenuItem Header="_Actual Size"
                          IsCheckable="True"
                          IsChecked="{Binding ZoomMode, Converter={StaticResource EnumEquals}, ConverterParameter=ActualSize, Mode=OneWay}"
                          Command="{Binding SetZoomModeCommand}" CommandParameter="{x:Static vm:ZoomMode.ActualSize}"/>
                <Separator/>
                <MenuItem Header="_Customise Toolbar..." Command="{Binding CustomiseToolbarCommand}"/>
                <Separator/>
                <MenuItem Header="_Theme">
                    <MenuItem Header="_Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                    <MenuItem Header="_Light" Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_View Help" InputGestureText="F1" Click="Help_Click"/>
                <Separator/>
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar: WrapPanel so it flows onto multiple lines on narrow windows. -->
        <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Profile switcher on far right; always visible. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4">
                    <TextBlock Text="Profile:" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="6,0,4,0"/>
                    <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding ActiveProfileName, Mode=TwoWay}" MinWidth="100" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ToolButton}" x:Name="TB_Customise" Command="{Binding CustomiseToolbarCommand}" ToolTip="Customise Toolbar" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="&#xE713;" Style="{StaticResource ToolGlyph}"/>
                            <TextBlock Text="Customise" Style="{StaticResource ToolLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <WrapPanel x:Name="ToolbarPanel" Orientation="Horizontal" Margin="6,4">
                    <Button Style="{StaticResource ToolButton}" x:Name="TB_Open" Command="{Binding OpenCommand}" ToolTip="Open (Ctrl+O)">
                        <StackPanel><TextBlock Text="&#xE838;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Open" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" x:Name="TB_Save" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)">
                        <StackPanel><TextBlock Text="&#xE74E;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Save" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" x:Name="TB_Print" Command="{Binding PrintCommand}" ToolTip="Print (Ctrl+P)">
                        <StackPanel><TextBlock Text="&#xE749;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Print" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" x:Name="TB_EditInWord" Command="{Binding EditInWordCommand}" ToolTip="Round-trip to Word and back">
                        <StackPanel><TextBlock Text="&#xE70F;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Word" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" x:Name="TB_Undo" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)">
                        <StackPanel><TextBlock Text="&#xE7A7;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Undo" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>

                    <Separator Width="1" Background="{DynamicResource Border}" Margin="6,4"/>

                    <Button Style="{StaticResource ToolToggleButton}" x:Name="TB_Select" Command="{Binding SetToolCommand}" CommandParameter="Select" ToolTip="Select / Move">
                        <StackPanel><TextBlock Text="&#xE8B0;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Select" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolToggleButton}" x:Name="TB_Highlight" Command="{Binding SetToolCommand}" CommandParameter="Highlight" ToolTip="Highlight">
                        <StackPanel><TextBlock Text="&#xE7E6;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Highlight" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolToggleButton}" x:Name="TB_StickyNote" Command="{Binding SetToolCommand}" CommandParameter="StickyNote" ToolTip="Sticky Note">
                        <StackPanel><TextBlock Text="&#xE734;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Note" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <!-- Text-tool group: Text / Tick / X / Bullet. Click opens picker.
                         CommandParameter binds to the group's current tool so the
                         ToolToggleButton style highlights the button when it's active. -->
                    <Button Style="{StaticResource ToolToggleButton}" x:Name="TB_TextGroup"
                            CommandParameter="{Binding CurrentTextTool}"
                            Click="TextGroup_ShowMenu" ToolTip="Text tools (Text · Tickmark · Crossmark · Bullet)">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="TB_TextGroup_Glyph" Text="&#xE8D2;" Style="{StaticResource ToolGlyph}"/>
                                <TextBlock Text=" ▾" FontSize="10" VerticalAlignment="Center" Opacity="0.7"/>
                            </StackPanel>
                            <TextBlock x:Name="TB_TextGroup_Label" Text="Text" Style="{StaticResource ToolLabel}"/>
                        </StackPanel>
                    </Button>

                    <!-- Shape-tool group: Draw / Rect / Rect filled / Oval / Oval filled. -->
                    <Button Style="{StaticResource ToolToggleButton}" x:Name="TB_ShapeGroup"
                            CommandParameter="{Binding CurrentShapeTool}"
                            Click="ShapeGroup_ShowMenu" ToolTip="Shape tools (Draw · Rect · Oval, outlined or filled)">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="TB_ShapeGroup_Glyph" Text="&#xE003;" Style="{StaticResource ToolGlyph}"/>
                                <TextBlock Text=" ▾" FontSize="10" VerticalAlignment="Center" Opacity="0.7"/>
                            </StackPanel>
                            <TextBlock x:Name="TB_ShapeGroup_Label" Text="Rect" Style="{StaticResource ToolLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolToggleButton}" x:Name="TB_Whiteout" Command="{Binding SetToolCommand}" CommandParameter="Whiteout" ToolTip="Whiteout — cover with a white box">
                        <StackPanel><TextBlock Text="&#xE711;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="White" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolToggleButton}" x:Name="TB_Erase" Command="{Binding SetToolCommand}" CommandParameter="Erase" ToolTip="Erase (last under cursor)">
                        <StackPanel><TextBlock Text="&#xE75C;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Erase" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolToggleButton}" x:Name="TB_SelectText" Command="{Binding SetToolCommand}" CommandParameter="SelectText" ToolTip="Select text region — drag to copy or replace">
                        <StackPanel><TextBlock Text="&#xE1D8;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Sel Text" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolToggleButton}" x:Name="TB_SelectImage" Command="{Binding SetToolCommand}" CommandParameter="SelectImage" ToolTip="Select region as image — drag to copy or save PNG">
                        <StackPanel><TextBlock Text="&#xE8B9;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Sel Image" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>

                    <Separator Width="1" Background="{DynamicResource Border}" Margin="6,4"/>

                    <StackPanel x:Name="TB_ColourSwatches" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <Button x:Name="TB_ColourButton" Click="ColourButton_Click" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Padding="4,2"
                                ToolTip="Choose the annotation colour">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Colour:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0"/>
                                <Border Width="24" Height="24" CornerRadius="3" SnapsToDevicePixels="True"
                                        Background="{Binding CurrentColor, Converter={StaticResource ColorToBrush}}"
                                        BorderBrush="{Binding CurrentColor, Converter={StaticResource ContrastBorder}}"
                                        BorderThickness="1"/>
                                <TextBlock Text=" ▾" FontSize="10" VerticalAlignment="Center" Opacity="0.7" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Separator Width="1" Background="{DynamicResource Border}" Margin="6,4"/>

                    <Button Style="{StaticResource ToolButton}" x:Name="TB_RotateLeft" Command="{Binding RotateLeftCommand}" ToolTip="Rotate left 90°">
                        <StackPanel><TextBlock Text="&#xE7AD;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Rotate L" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" x:Name="TB_RotateRight" Command="{Binding RotateRightCommand}" ToolTip="Rotate right 90°">
                        <StackPanel><TextBlock Text="&#xE7AC;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Rotate R" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" x:Name="TB_DeletePage" Command="{Binding DeleteCurrentPageCommand}" ToolTip="Delete current page">
                        <StackPanel><TextBlock Text="&#xE74D;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Del Page" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>

                    <Separator Width="1" Background="{DynamicResource Border}" Margin="6,4"/>

                    <Button Style="{StaticResource ToolButton}" x:Name="TB_InsertImage" Command="{Binding InsertImageOnCurrentCommand}" ToolTip="Insert image on current page">
                        <StackPanel><TextBlock Text="&#xEB9F;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Image" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" x:Name="TB_Signatures" Command="{Binding OpenSignatureLibraryCommand}" ToolTip="Signatures">
                        <StackPanel><TextBlock Text="&#xE929;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Sign" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>

                    <Separator Width="1" Background="{DynamicResource Border}" Margin="6,4"/>

                    <Button Style="{StaticResource ToolButton}" x:Name="TB_ZoomOut" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+-)">
                        <StackPanel><TextBlock Text="&#xE71F;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Zoom −" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                    <ComboBox x:Name="TB_ZoomLevel" Width="110" Margin="4,0" IsEditable="True" VerticalAlignment="Center"
                              LostFocus="ZoomCombo_LostFocus" SelectionChanged="ZoomCombo_SelectionChanged" KeyDown="ZoomCombo_KeyDown">
                        <ComboBoxItem>Fit Width</ComboBoxItem>
                        <ComboBoxItem>Fit Page</ComboBoxItem>
                        <ComboBoxItem>Actual Size</ComboBoxItem>
                        <ComboBoxItem>25%</ComboBoxItem>
                        <ComboBoxItem>50%</ComboBoxItem>
                        <ComboBoxItem>75%</ComboBoxItem>
                        <ComboBoxItem>100%</ComboBoxItem>
                        <ComboBoxItem>125%</ComboBoxItem>
                        <ComboBoxItem>150%</ComboBoxItem>
                        <ComboBoxItem>200%</ComboBoxItem>
                        <ComboBoxItem>300%</ComboBoxItem>
                        <ComboBoxItem>400%</ComboBoxItem>
                    </ComboBox>
                    <Button Style="{StaticResource ToolButton}" x:Name="TB_ZoomIn" Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl++)">
                        <StackPanel><TextBlock Text="&#xE8A3;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Zoom +" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>

                    <Separator Width="1" Background="{DynamicResource Border}" Margin="6,4"/>

                    <TextBox x:Name="TB_SearchBox" Width="200" VerticalAlignment="Center"
                             BorderThickness="2"
                             BorderBrush="{DynamicResource InputFg}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchBox_KeyDown" ToolTip="Search text (Ctrl+F, Enter to run)"/>
                    <CheckBox x:Name="TB_WholeWord" VerticalAlignment="Center" Margin="6,0,0,0"
                              Content="Whole word"
                              IsChecked="{Binding SearchWholeWord}"
                              Foreground="{DynamicResource Foreground}"
                              ToolTip="Match whole words only"/>
                    <Button Style="{StaticResource ToolButton}" x:Name="TB_Find" Command="{Binding SearchCommand}" ToolTip="Find">
                        <StackPanel><TextBlock Text="&#xE721;" Style="{StaticResource ToolGlyph}"/><TextBlock Text="Find" Style="{StaticResource ToolLabel}"/></StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Content: 3-column -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left: thumbnails -->
            <Border Grid.Column="0" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8,8,8,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Pages" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ToolButton}" Command="{Binding PrevPageCommand}" ToolTip="Previous page" Padding="6,2">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Text}"/>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBox Width="42" VerticalAlignment="Center" TextAlignment="Center"
                                         Text="{Binding PageNumberInput, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="PageNumberBox_KeyDown" ToolTip="Type a page number and press Enter"/>
                                <TextBlock Text="{Binding TotalPages, StringFormat=' / {0}'}" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource ToolButton}" Command="{Binding NextPageCommand}" ToolTip="Next page" Padding="6,2">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Text}"/>
                            </Button>
                        </Grid>
                    </Grid>
                    <ListBox x:Name="ThumbList" ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                             SelectionChanged="ThumbList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             VirtualizingStackPanel.IsVirtualizing="False"
                             HorizontalContentAlignment="Center"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="ThumbList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ThumbList_PreviewMouseMove"
                             PreviewDragEnter="ThumbList_DragOver"
                             PreviewDragOver="ThumbList_DragOver"
                             PreviewDrop="ThumbList_Drop"
                             DragEnter="ThumbList_DragOver"
                             DragOver="ThumbList_DragOver"
                             Drop="ThumbList_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6" HorizontalAlignment="Center">
                                    <Border BorderBrush="#555" BorderThickness="1">
                                        <Image Source="{Binding Thumbnail}" MaxWidth="140" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayNumber}" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource Border}" HorizontalAlignment="Stretch"/>

            <!-- Center: pages -->
            <ScrollViewer Grid.Column="2" x:Name="PagesScroller"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          Background="{DynamicResource Bg}"
                          CanContentScroll="False"
                          ScrollChanged="PagesScroller_ScrollChanged">
                <ItemsControl ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="12">
                                <Viewbox.MaxWidth>
                                    <MultiBinding Converter="{StaticResource ZoomWidth}" ConverterParameter="24">
                                        <Binding Path="ActualWidth"  ElementName="PagesScroller"/>
                                        <Binding Path="ActualHeight" ElementName="PagesScroller"/>
                                        <Binding Path="DataContext.ZoomMode" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.Zoom"     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="WidthPt"/>
                                        <Binding Path="HeightPt"/>
                                    </MultiBinding>
                                </Viewbox.MaxWidth>
                                <Viewbox.MaxHeight>
                                    <MultiBinding Converter="{StaticResource ZoomHeight}" ConverterParameter="24">
                                        <Binding Path="ActualWidth"  ElementName="PagesScroller"/>
                                        <Binding Path="ActualHeight" ElementName="PagesScroller"/>
                                        <Binding Path="DataContext.ZoomMode" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.Zoom"     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="WidthPt"/>
                                        <Binding Path="HeightPt"/>
                                    </MultiBinding>
                                </Viewbox.MaxHeight>
                                <Border BorderBrush="#111" BorderThickness="1"
                                        Background="White" SnapsToDevicePixels="True"
                                        Width="{Binding PixelWidth}" Height="{Binding PixelHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.5" ShadowDepth="0" BlurRadius="8"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Image Source="{Binding PageImage}"
                                               Stretch="Fill" SnapsToDevicePixels="True"/>
                                        <ctrl:AnnotationLayer
                                            Page="{Binding}"
                                            MainVM="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Grid>
                                </Border>
                            </Viewbox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter Grid.Column="3" Width="4" Background="{DynamicResource Border}" HorizontalAlignment="Stretch"/>

            <!-- Right: search results + extracted text -->
            <Border Grid.Column="4" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Bookmarks" Padding="10,8" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                    <TreeView Grid.Row="1" ItemsSource="{Binding Bookmarks}" Background="{DynamicResource PanelAlt}"
                              Foreground="{DynamicResource Text}" BorderThickness="0"
                              MouseDoubleClick="Bookmarks_DoubleClick"
                              x:Name="BookmarksTree"
                              MaxHeight="180">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="{Binding PageIndex, StringFormat=(p{0})}" Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Search results" Padding="10,8" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextMuted}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CurrentHitIndex" Converter="{StaticResource OneBasedIndex}"/>
                                    <Binding Path="SearchResults.Count"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Button Grid.Column="2" Style="{StaticResource ToolButton}" Command="{Binding PrevSearchHitCommand}" ToolTip="Previous hit (Shift+F3)" Padding="6,2" Margin="0,0,2,0">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Text}"/>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource ToolButton}" Command="{Binding NextSearchHitCommand}" ToolTip="Next hit (F3)" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Text}"/>
                        </Button>
                    </Grid>
                    <ListBox Grid.Row="3" x:Name="ResultsList" ItemsSource="{Binding SearchResults}"
                             SelectionChanged="SearchResults_SelectionChanged"
                             MouseDoubleClick="SearchResults_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding PageIndex, StringFormat=Page {0}}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" Foreground="{DynamicResource Text}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="4" Text="Extracted text" Padding="10,8" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="5" Text="{Binding ExtractedText}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding CurrentPage.DisplayNumber, StringFormat=Page {0}, FallbackValue=''}"
                           Foreground="{DynamicResource TextMuted}"/>
                <TextBox Text="{Binding StatusText, Mode=OneWay}"
                         Foreground="{DynamicResource Text}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         Cursor="IBeam"
                         ToolTip="Click to place cursor · drag to select · Ctrl+C or right-click to copy"/>
            </DockPanel>
        </Border>

        <!-- Busy overlay -->
        <Grid Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="{Binding IsBusy}">
            <Border Background="{DynamicResource Panel}" Padding="24" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Working..." Foreground="{DynamicResource Text}" FontSize="16" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="240" Height="6" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
