<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\PDFEditor.ico</ApplicationIcon>
    <AssemblyName>PDFEditor</AssemblyName>
    <RootNamespace>PDFEditor</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>CA1416;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PDFEditor.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Help\help.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <PackageReference Include="PDFtoImage" Version="5.1.0" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
  </ItemGroup>

</Project>
